[
  {
    "id": "deploy-production",
    "execute-command": "/root/aadikarta-app/production/deploy.sh",
    "command-working-directory": "/root/aadikarta-app/production",
    "trigger-rule": {
      "match": {
        "type": "payload-hmac-sha256",
        "secret": "{{ getenv \"DEPLOY_WEBHOOK_SECRET\" }}",
        "parameter": {
          "source": "header",
          "name": "X-Hub-Signature-256"
        }
      }
    }
  }
]
